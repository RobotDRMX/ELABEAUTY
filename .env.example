# ── Base de datos PostgreSQL (Supabase) ───────────────────────────────────────
# Obtener en: Supabase Dashboard → Settings → Database → Connection parameters
DB_HOST=db.XXXXXXXXXXXX.supabase.co
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=TU_PASSWORD_DE_SUPABASE
DB_NAME=postgres
DB_SYNCHRONIZE=true
DB_LOGGING=false
DB_SSL=true

# ── Servidor ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Frontend URL para CORS ────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:4200

# ── JWT ───────────────────────────────────────────────────────────────────────
# Genera uno seguro con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REEMPLAZAR_CON_UN_SECRET_SEGURO

# ── reCAPTCHA v3 ──────────────────────────────────────────────────────────────
# Obtener en: https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET_KEY=TU_RECAPTCHA_SECRET_KEY

# ── Supabase — email delivery y validación OTP ────────────────────────────────
# Obtener en: Supabase Dashboard → Settings → API
SUPABASE_URL=https://XXXXXXXXXXXX.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
